---
import AdminLayout from '../../layouts/AdminLayout.astro';
import OpportunityTable from '../../components/react/OpportunityTable';

const searchParam = Astro.url.searchParams.get('search') || '';
---

<AdminLayout pageTitle="Opportunity Explorer">
  <div class="space-y-6">
    <div>
      <h1 class="text-2xl font-bold tracking-tight text-slate-900 dark:text-white">
        Opportunity Intelligence Catalog
      </h1>
      <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">
        Search, filter, inspect, and verify scholarships, internships, research fellowships, and student awards.
      </p>
    </div>

    <!-- Opportunity Table React Island with Admin Controls -->
    <OpportunityTable client:load isAdmin={true} initialSearch={searchParam} />
  </div>
</AdminLayout>
