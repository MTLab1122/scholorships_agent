---
import AdminLayout from '../../layouts/AdminLayout.astro';
import SettingsForm from '../../components/react/SettingsForm';
---

<AdminLayout pageTitle="System Settings">
  <div class="space-y-6 max-w-4xl">
    <div>
      <h1 class="text-2xl font-bold tracking-tight text-slate-900 dark:text-white">
        System Preferences & Intelligence Parameters
      </h1>
      <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">
        Configure AI provider models, daily automation schedules, notification dispatch addresses, and Charsadda priority multipliers.
      </p>
    </div>

    <!-- Settings Form React Island -->
    <SettingsForm client:load />
  </div>
</AdminLayout>
