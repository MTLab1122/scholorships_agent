---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { api } from '../../lib/api';
import type { AuditLog } from '../../lib/types';

let health = { status: 'healthy', opportunities_count: 0, sources_count: 0, database: 'sqlite' };
let auditLogs: AuditLog[] = [];

try {
  health = await api.getHealth();
  auditLogs = await api.getAuditLogs(10);
} catch (e) {
  console.error("Health fetch error:", e);
}
---

<AdminLayout pageTitle="System Health & Activity">
  <div class="space-y-6">
    <div>
      <h1 class="text-2xl font-bold tracking-tight text-slate-900 dark:text-white">
        System Vitality & Activity Center
      </h1>
      <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">
        Real-time telemetry, database operational state, and recent multi-agent system execution events.
      </p>
    </div>

    <!-- Health Grid -->
    <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
      <div class="p-5 bg-white dark:bg-slate-800 rounded-xl border border-slate-200 dark:border-slate-700 shadow-sm flex items-center gap-3">
        <div class="w-10 h-10 rounded-xl bg-emerald-50 dark:bg-emerald-950/60 text-emerald-600 dark:text-emerald-400 flex items-center justify-center font-bold text-lg">
          ✓
        </div>
        <div>
          <div class="text-xs font-semibold text-slate-400">Platform Health</div>
          <div class="text-base font-bold text-slate-900 dark:text-white capitalize">
            {health.status || 'Operational'}
          </div>
        </div>
      </div>

      <div class="p-5 bg-white dark:bg-slate-800 rounded-xl border border-slate-200 dark:border-slate-700 shadow-sm flex items-center gap-3">
        <div class="w-10 h-10 rounded-xl bg-sky-50 dark:bg-sky-950/60 text-sky-600 dark:text-sky-400 flex items-center justify-center font-bold text-lg">
          💾
        </div>
        <div>
          <div class="text-xs font-semibold text-slate-400">Active Records</div>
          <div class="text-base font-bold text-slate-900 dark:text-white">
            {health.opportunities_count} Opportunities
          </div>
        </div>
      </div>

      <div class="p-5 bg-white dark:bg-slate-800 rounded-xl border border-slate-200 dark:border-slate-700 shadow-sm flex items-center gap-3">
        <div class="w-10 h-10 rounded-xl bg-indigo-50 dark:bg-indigo-950/60 text-indigo-600 dark:text-indigo-400 flex items-center justify-center font-bold text-lg">
          🌐
        </div>
        <div>
          <div class="text-xs font-semibold text-slate-400">Monitored Sources</div>
          <div class="text-base font-bold text-slate-900 dark:text-white">
            {health.sources_count} Official Portals
          </div>
        </div>
      </div>

      <div class="p-5 bg-white dark:bg-slate-800 rounded-xl border border-slate-200 dark:border-slate-700 shadow-sm flex items-center gap-3">
        <div class="w-10 h-10 rounded-xl bg-purple-50 dark:bg-purple-950/60 text-purple-600 dark:text-purple-400 flex items-center justify-center font-bold text-lg">
          ⚙️
        </div>
        <div>
          <div class="text-xs font-semibold text-slate-400">Persistence Engine</div>
          <div class="text-base font-bold text-slate-900 dark:text-white">
            Transactional SQLite
          </div>
        </div>
      </div>
    </div>

    <!-- Recent Activity Trail -->
    <div class="bg-white dark:bg-slate-800 p-6 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-sm space-y-4">
      <div class="flex items-center justify-between pb-3 border-b border-slate-100 dark:border-slate-700">
        <h2 class="text-sm font-bold text-slate-900 dark:text-white">
          Recent Multi-Agent & Administrative Event Stream
        </h2>
        <a
          href="/admin/audit-logs"
          class="text-xs font-semibold text-sky-600 dark:text-sky-400 hover:underline"
        >
          View Full Audit Log →
        </a>
      </div>

      <div class="divide-y divide-slate-100 dark:divide-slate-700/60 text-xs">
        {auditLogs.map((log) => (
          <div class="py-3 flex items-start justify-between gap-4">
            <div class="space-y-0.5">
              <div class="flex items-center gap-2">
                <span class="font-bold text-slate-900 dark:text-slate-100 uppercase font-mono text-[11px]">
                  [{log.actor}] {log.action}
                </span>
                <span class="px-1.5 py-0.5 rounded text-[10px] font-semibold bg-slate-100 dark:bg-slate-700 text-slate-600 dark:text-slate-300">
                  {log.target_type}
                </span>
              </div>
              <p class="text-slate-600 dark:text-slate-300">
                {log.details}
              </p>
            </div>
            <span class="text-[11px] text-slate-400 whitespace-nowrap font-mono">
              {log.timestamp}
            </span>
          </div>
        ))}
      </div>
    </div>
  </div>
</AdminLayout>
