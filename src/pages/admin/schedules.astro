---
import AdminLayout from '../../layouts/AdminLayout.astro';
import SchedulesManager from '../../components/react/SchedulesManager';
---

<AdminLayout pageTitle="Schedules">
  <div class="space-y-6">
    <div>
      <h1 class="text-2xl font-bold tracking-tight text-slate-900 dark:text-white">
        Background Automation Schedules
      </h1>
      <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">
        Cron schedules governing daily discovery scans, deadline countdown tracking, and weekly report packages.
      </p>
    </div>

    <!-- Schedules Manager React Island -->
    <SchedulesManager client:load />
  </div>
</AdminLayout>
