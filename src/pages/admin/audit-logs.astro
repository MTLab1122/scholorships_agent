---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { api } from '../../lib/api';
import type { AuditLog } from '../../lib/types';

let logs: AuditLog[] = [];
try {
  logs = await api.getAuditLogs(100);
} catch (e) {
  console.error("Audit log error:", e);
}
---

<AdminLayout pageTitle="Audit Logs">
  <div class="space-y-6">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
      <div>
        <h1 class="text-2xl font-bold tracking-tight text-slate-900 dark:text-white">
          System Audit Trail & Governance Logs
        </h1>
        <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">
          Cryptographically recorded administrative interventions, source additions, verification approvals, and schedule triggers.
        </p>
      </div>

      <div class="px-3.5 py-1.5 rounded-lg bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-700 text-xs font-mono font-bold">
        {logs.length} Logged Entries
      </div>
    </div>

    <!-- Audit Logs Table -->
    <div class="bg-white dark:bg-slate-800 rounded-xl border border-slate-200 dark:border-slate-700 shadow-sm overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse text-xs">
          <thead>
            <tr class="bg-slate-50 dark:bg-slate-900/60 border-b border-slate-200 dark:border-slate-700 font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider">
              <th class="py-3 px-4">Timestamp</th>
              <th class="py-3 px-4">Actor</th>
              <th class="py-3 px-4">Action</th>
              <th class="py-3 px-4">Target Entity</th>
              <th class="py-3 px-4">Details & Rationale</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100 dark:divide-slate-700/60 font-mono">
            {logs.map((log) => (
              <tr class="hover:bg-slate-50/60 dark:hover:bg-slate-750 transition-colors">
                <td class="py-3 px-4 text-slate-400 whitespace-nowrap text-[11px]">
                  {log.timestamp}
                </td>
                <td class="py-3 px-4 font-bold text-sky-600 dark:text-sky-400">
                  {log.actor}
                </td>
                <td class="py-3 px-4">
                  <span class="px-2 py-0.5 rounded text-[11px] font-bold bg-slate-100 dark:bg-slate-700 text-slate-700 dark:text-slate-300">
                    {log.action}
                  </span>
                </td>
                <td class="py-3 px-4 text-slate-500">
                  {log.target_type} ({log.target_id || '-'})
                </td>
                <td class="py-3 px-4 font-sans text-slate-800 dark:text-slate-200">
                  {log.details}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </div>
</AdminLayout>
