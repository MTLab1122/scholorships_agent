---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { api } from '../../lib/api';
import type { StudentProfile } from '../../lib/types';

let students: StudentProfile[] = [];
try {
  students = await api.getStudents();
} catch (e) {
  console.error("Failed to load students:", e);
}
---

<AdminLayout pageTitle="Student Directory">
  <div class="space-y-6">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
      <div>
        <h1 class="text-2xl font-bold tracking-tight text-slate-900 dark:text-white">
          Registered Student Profiles Directory
        </h1>
        <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">
          Authorized administrative view of student academic standings, domicile distributions, and matching telemetry.
        </p>
      </div>

      <div class="px-3.5 py-1.5 rounded-lg bg-sky-50 dark:bg-sky-950/50 text-sky-700 dark:text-sky-300 border border-sky-200 dark:border-sky-800/40 text-xs font-bold">
        {students.length} Profiles Enrolled
      </div>
    </div>

    <!-- Student Profiles Table -->
    <div class="bg-white dark:bg-slate-800 rounded-xl border border-slate-200 dark:border-slate-700 shadow-sm overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse text-xs">
          <thead>
            <tr class="bg-slate-50 dark:bg-slate-900/60 border-b border-slate-200 dark:border-slate-700 font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider">
              <th class="py-3 px-4">Student</th>
              <th class="py-3 px-4">University & Sector</th>
              <th class="py-3 px-4">Discipline & Stage</th>
              <th class="py-3 px-4">Academic Standing</th>
              <th class="py-3 px-4">Domicile</th>
              <th class="py-3 px-4 text-right">Actions</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100 dark:divide-slate-700/60">
            {students.map((stu) => (
              <tr class="hover:bg-slate-50/60 dark:hover:bg-slate-750 transition-colors">
                <td class="py-3 px-4">
                  <div class="font-bold text-slate-900 dark:text-slate-100">{stu.full_name}</div>
                  <div class="text-[11px] text-slate-500">{stu.email}</div>
                </td>
                <td class="py-3 px-4">
                  <div class="font-medium text-slate-800 dark:text-slate-200">{stu.university}</div>
                  <span class="inline-block mt-0.5 px-2 py-0.5 rounded text-[10px] font-semibold bg-slate-100 dark:bg-slate-700 text-slate-600 dark:text-slate-300 capitalize">
                    {stu.university_type || 'public'}
                  </span>
                </td>
                <td class="py-3 px-4">
                  <div class="text-slate-800 dark:text-slate-200">{stu.discipline}</div>
                  <div class="text-[11px] text-slate-500">{stu.degree_level} • Semester {stu.current_semester}</div>
                </td>
                <td class="py-3 px-4">
                  <span class="font-mono font-bold text-sky-600 dark:text-sky-400">
                    CGPA {stu.cgpa.toFixed(2)}
                  </span>
                </td>
                <td class="py-3 px-4">
                  <span class="inline-flex items-center gap-1 font-medium text-slate-700 dark:text-slate-300">
                    📍 {stu.domicile_district || 'KP'}
                  </span>
                </td>
                <td class="py-3 px-4 text-right">
                  <a
                    href={`/student/recommendations`}
                    class="px-2.5 py-1 text-[11px] font-semibold text-sky-600 hover:bg-sky-50 dark:hover:bg-sky-950/50 rounded border border-sky-200 dark:border-sky-800/40 transition-colors"
                  >
                    View Matches
                  </a>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </div>
</AdminLayout>
