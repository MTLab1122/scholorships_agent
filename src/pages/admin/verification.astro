---
import AdminLayout from '../../layouts/AdminLayout.astro';
import VerificationQueue from '../../components/react/VerificationQueue';
---

<AdminLayout pageTitle="Verification Queue">
  <div class="space-y-6">
    <div>
      <h1 class="text-2xl font-bold tracking-tight text-slate-900 dark:text-white">
        Verification & Review Queue
      </h1>
      <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">
        Review unverified items, assess verbatim evidence quotes, and maintain gazette publication standards.
      </p>
    </div>

    <!-- Verification Queue React Island -->
    <VerificationQueue client:load />
  </div>
</AdminLayout>
