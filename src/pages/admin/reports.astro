---
import AdminLayout from '../../layouts/AdminLayout.astro';
import ReportManager from '../../components/react/ReportManager';
---

<AdminLayout pageTitle="20 Report Center">
  <div class="space-y-6">
    <div>
      <h1 class="text-2xl font-bold tracking-tight text-slate-900 dark:text-white">
        Standardized 20-Report Center
      </h1>
      <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">
        Configure, compile, and download publication-ready reports in Vector PDF, multi-tab Excel, CSV, and HTML.
      </p>
    </div>

    <!-- 20 Report Manager React Island -->
    <ReportManager client:load />
  </div>
</AdminLayout>
