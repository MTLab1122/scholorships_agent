---
import AdminLayout from '../../layouts/AdminLayout.astro';
import SourceManager from '../../components/react/SourceManager';
---

<AdminLayout pageTitle="Source Registry">
  <div class="space-y-6">
    <div>
      <h1 class="text-2xl font-bold tracking-tight text-slate-900 dark:text-white">
        Official Source Registry & Connectivity
      </h1>
      <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">
        Manage accredited university domains, HEC feeds, and test portal HTTP reachability.
      </p>
    </div>

    <!-- Source Manager React Island -->
    <SourceManager client:load />
  </div>
</AdminLayout>
