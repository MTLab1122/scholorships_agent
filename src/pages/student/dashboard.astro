---
import StudentLayout from '../../layouts/StudentLayout.astro';
import { api } from '../../lib/api';
import type { StudentProfile, StudentMatch, Opportunity, ApplicationRecord } from '../../lib/types';

let student: StudentProfile = {
  id: 'student-charsadda-cs-01',
  full_name: 'Muhammad Khan',
  email: 'student.charsadda@example.com',
  university: 'Bacha Khan University Charsadda',
  university_type: 'public',
  degree_level: 'Undergraduate',
  discipline: 'Computer Science',
  current_semester: 4,
  cgpa: 3.65,
  domicile_district: 'Charsadda',
  domicile_province: 'Khyber Pakhtunkhwa'
};

let matches: StudentMatch[] = [];
let savedCount = 0;
let applicationsCount = 0;

try {
  const students = await api.getStudents();
  if (students.length > 0) {
    student = students[0];
  }
  const matchRes = await api.getStudentMatches(student.id);
  matches = matchRes?.matches || [];
  const saved = await api.getSavedOpportunities(student.id);
  savedCount = saved?.length || 0;
  const apps = await api.getApplications(student.id);
  applicationsCount = apps?.length || 0;
} catch (e) {
  console.error("Student dashboard load error:", e);
}

const strongMatches = matches.filter((m) => m.match_score >= 80);
---

<StudentLayout pageTitle="Student Dashboard">
  <div class="space-y-6">
    <!-- Welcome Banner -->
    <div class="bg-gradient-to-r from-sky-900 via-indigo-900 to-slate-900 p-6 rounded-2xl text-white shadow-md flex flex-col md:flex-row md:items-center justify-between gap-4">
      <div>
        <div class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[11px] font-semibold bg-sky-500/20 text-sky-300 border border-sky-400/30 mb-2">
          🎓 Semester {student.current_semester} • {student.discipline}
        </div>
        <h1 class="text-2xl font-bold tracking-tight">
          Welcome back, {student.full_name}
        </h1>
        <p class="text-xs text-slate-300 mt-1 max-w-2xl leading-relaxed">
          {student.university} ({student.domicile_district} Domicile). The intelligence system has evaluated the opportunity catalog against your academic standing and domicile quotas.
        </p>
      </div>

      <div class="flex items-center gap-2">
        <a
          href="/student/recommendations"
          class="px-4 py-2 text-xs font-semibold bg-sky-500 hover:bg-sky-400 text-white rounded-xl shadow-lg shadow-sky-500/20 transition-all whitespace-nowrap"
        >
          View All {matches.length} Matches →
        </a>
      </div>
    </div>

    <!-- 4 KPI Cards -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
      <div class="bg-white dark:bg-slate-800 p-4 rounded-xl border border-slate-200 dark:border-slate-700 shadow-sm">
        <div class="text-xs font-semibold text-slate-500 dark:text-slate-400">Personalized Matches</div>
        <div class="text-2xl font-black text-slate-900 dark:text-white mt-1">{matches.length}</div>
        <div class="text-[11px] text-slate-400 mt-0.5">Eligible opportunities</div>
      </div>

      <div class="bg-white dark:bg-slate-800 p-4 rounded-xl border border-slate-200 dark:border-slate-700 shadow-sm">
        <div class="text-xs font-semibold text-slate-500 dark:text-slate-400">Strong Matches</div>
        <div class="text-2xl font-black text-emerald-600 dark:text-emerald-400 mt-1">{strongMatches.length}</div>
        <div class="text-[11px] text-slate-400 mt-0.5">&ge; 80% Match Score</div>
      </div>

      <div class="bg-white dark:bg-slate-800 p-4 rounded-xl border border-slate-200 dark:border-slate-700 shadow-sm">
        <div class="text-xs font-semibold text-slate-500 dark:text-slate-400">Saved Bookmarks</div>
        <div class="text-2xl font-black text-amber-600 dark:text-amber-400 mt-1">{savedCount}</div>
        <div class="text-[11px] text-slate-400 mt-0.5">Ready for application</div>
      </div>

      <div class="bg-white dark:bg-slate-800 p-4 rounded-xl border border-slate-200 dark:border-slate-700 shadow-sm">
        <div class="text-xs font-semibold text-slate-500 dark:text-slate-400">Tracked Applications</div>
        <div class="text-2xl font-black text-indigo-600 dark:text-indigo-400 mt-1">{applicationsCount}</div>
        <div class="text-[11px] text-slate-400 mt-0.5">In 9-stage pipeline</div>
      </div>
    </div>

    <!-- Top Recommendations Cards -->
    <div class="space-y-4">
      <div class="flex items-center justify-between">
        <h2 class="text-base font-bold text-slate-900 dark:text-white flex items-center gap-2">
          <span>✨</span> Top Recommended Opportunities for You
        </h2>
        <a href="/student/recommendations" class="text-xs font-semibold text-sky-600 dark:text-sky-400 hover:underline">
          See All Matches →
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {matches.slice(0, 4).map((m) => (
          <div class="bg-white dark:bg-slate-800 p-5 rounded-xl border border-slate-200 dark:border-slate-700 shadow-sm flex flex-col justify-between hover:border-sky-300 dark:hover:border-sky-600 transition-all text-xs space-y-3">
            <div>
              <div class="flex items-start justify-between gap-2">
                <div>
                  <h3 class="font-bold text-sm text-slate-900 dark:text-white line-clamp-1">
                    {m.opportunity_name}
                  </h3>
                  <div class="text-[11px] text-slate-500 mt-0.5">
                    {m.sponsor} • <span class="capitalize">{m.category}</span>
                  </div>
                </div>

                <div class="flex flex-col items-end">
                  <span class="px-2.5 py-1 rounded-full text-xs font-black bg-emerald-100 text-emerald-800 dark:bg-emerald-950/60 dark:text-emerald-300">
                    {m.match_score}% Match
                  </span>
                </div>
              </div>

              <!-- Match Justification Reasons -->
              <div class="mt-3 p-3 bg-slate-50 dark:bg-slate-900/40 rounded-lg border border-slate-100 dark:border-slate-800 space-y-1">
                <span class="font-semibold text-slate-700 dark:text-slate-300 block text-[11px]">
                  Why this matches you:
                </span>
                {m.reasons.slice(0, 3).map((r) => (
                  <div class="text-[11px] text-slate-600 dark:text-slate-400 flex items-start gap-1.5">
                    <span class="text-emerald-500 font-bold">✓</span> {r}
                  </div>
                ))}
              </div>
            </div>

            <div class="pt-2 border-t border-slate-100 dark:border-slate-700/60 flex items-center justify-between">
              <span class="text-slate-400 text-[11px]">
                Deadline: {m.deadline || 'Ongoing'}
              </span>
              <div class="flex items-center gap-2">
                {m.official_url && (
                  <a
                    href={m.official_url}
                    target="_blank"
                    rel="noreferrer"
                    class="px-3 py-1 font-semibold text-sky-600 dark:text-sky-400 hover:bg-sky-50 dark:hover:bg-sky-950/40 rounded border border-sky-200 dark:border-sky-800/40 transition-colors"
                  >
                    Apply Portal ↗
                  </a>
                )}
                <a
                  href="/student/prep"
                  class="px-3 py-1 font-semibold bg-sky-600 text-white rounded hover:bg-sky-700 transition-colors"
                >
                  Prepare Dossier
                </a>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</StudentLayout>
