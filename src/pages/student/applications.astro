---
import StudentLayout from '../../layouts/StudentLayout.astro';
import ApplicationKanban from '../../components/react/ApplicationKanban';
---

<StudentLayout pageTitle="Application Tracker">
  <div class="space-y-6">
    <div>
      <h1 class="text-2xl font-bold tracking-tight text-slate-900 dark:text-white">
        Personal Application Progress Tracker
      </h1>
      <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">
        Interactive 9-stage Kanban board. Track every opportunity from discovery through attested document submission and final decision.
      </p>
    </div>

    <!-- Application Kanban React Island -->
    <ApplicationKanban client:load studentId="student-charsadda-cs-01" />
  </div>
</StudentLayout>
