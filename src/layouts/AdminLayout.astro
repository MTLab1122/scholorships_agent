---
import Layout from './Layout.astro';
import Sidebar from '../components/Sidebar.astro';
import Header from '../components/Header.astro';

interface Props {
  title?: string;
  pageTitle?: string;
}

const { title = "Admin Control Center | Student Opportunity Intelligence", pageTitle = "Dashboard" } = Astro.props;
const currentPath = Astro.url.pathname;
---

<Layout title={title}>
  <div class="flex min-h-screen">
    <!-- Collapsible Sidebar -->
    <Sidebar role="admin" currentPath={currentPath} />

    <!-- Main Content Container -->
    <div class="flex-1 flex flex-col min-w-0 bg-slate-50 dark:bg-slate-950 transition-colors">
      <Header role="admin" pageTitle={pageTitle} />
      <main class="flex-1 p-4 sm:p-6 md:p-8 max-w-7xl w-full mx-auto animate-fade-in">
        <slot />
      </main>
    </div>
  </div>

  <script is:inline>
    // Client-side Role-Based Access Control guard
    try {
      const userRaw = localStorage.getItem('soi_auth_user');
      if (userRaw) {
        const user = JSON.parse(userRaw);
        if (user.role === 'student') {
          console.warn('Student account attempted access to Admin Center. Redirecting to student dashboard.');
          window.location.href = '/student/dashboard';
        }
      }
    } catch (e) {}
  </script>
</Layout>
