# ==============================================================================
# Student Opportunity Intelligence Platform — Environment Configuration
# ==============================================================================
# Copy this file to .env and replace the placeholder values with your credentials.
# NEVER commit the active .env file to public version control.

# ------------------------------------------------------------------------------
# 1. AI Provider Configuration (Google Gemini)
# ------------------------------------------------------------------------------
# Obtain an API key from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
# Recommended models: gemini-2.5-flash, gemini-1.5-flash, gemini-2.0-flash
GEMINI_MODEL=gemini-2.5-flash

# ------------------------------------------------------------------------------
# 2. Resend API Email Delivery (Primary Email Dispatcher)
# ------------------------------------------------------------------------------
# Obtain API key from: https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL=onboarding@resend.dev

# ------------------------------------------------------------------------------
# 3. Direct Gmail SMTP Delivery (Secondary / Fallback Dispatcher)
# ------------------------------------------------------------------------------
# Standard Gmail address used for authenticated SMTP dispatch
GMAIL_USER=your_email@gmail.com
# Google 16-character App Password (generate at https://myaccount.google.com/apppasswords)
GMAIL_APP_PASSWORD=your_16_char_app_password

# ------------------------------------------------------------------------------
# 4. Notification Recipient & Reports (Delivered exclusively to primary email)
# ------------------------------------------------------------------------------
OWNER_EMAIL=admin@example.com
RECIPIENT_EMAIL=admin@example.com
EMAIL_ATTACHMENT_FORMATS=pdf

# ------------------------------------------------------------------------------
# 5. Automation & Scheduling
# ------------------------------------------------------------------------------
# Pipeline execution trigger time in PKT (24-hour HH:MM format)
SCHEDULE_TIME=07:00

# ------------------------------------------------------------------------------
# 6. Server & Storage Options
# ------------------------------------------------------------------------------
HOST=127.0.0.1
PORT=8000
DATABASE_PATH=data/opportunities.db
REPORTS_DIR=reports
